+    # 从共享内存导入物理块
+    def import_physical_blocks_from_shared_memory(
+        self,
+        cache_engine: CacheEngine,
+        request_id: str,
+        block_ids: List[int],
+    ) -> bool:
+        if not block_ids:
+            return False
+
+        kv_cache_data = self.shared_memory_manager.load_logical_block(
