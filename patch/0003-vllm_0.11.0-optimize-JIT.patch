+# ================ OPTIMIZATION POINT 1 ================
+# 使用JIT进行加速
+@njit(nopython=True, parallel=False)
+def _compute_slot_mapping_jit(
+    req_indices,
+    positions,
+    block_table_flat,
+    max_num_blocks_per_req,
+    block_size,
+    dcp_world_size,
+    dcp_rank,
+    out_slot_mapping
+):
+    # E.g., [0, 1, 0, 1, 2, 3, 4, 0, 1, 2]
+    # -> [0, 0, K, K, K + 1, K + 1, K + 2, 2 * K, 2 * K, 2 * K + 1]
+    # where K is the max_num_blocks_per_req and the block size is 2.
+    # NOTE(woosuk): We can't simply use `token_indices // block_size`
+    # here because M (max_model_len) is not necessarily divisible by
+    # block_size.
+    num_tokens = req_indices.shape[0]
+    if dcp_world_size > 1:
+        # Note(hc): The DCP implement store kvcache with an interleave
+        # style, the kvcache for the token whose token_idx is i is
+        # always stored on the GPU whose dcp_rank equals i % cp_world_size:
+ 
+        # Use a "virtual block" which equals to world_size * block_size
+        # for block_table_indices calculation.
+        virtual_block_size = block_size * dcp_world_size
+        for i in range(num_tokens):
+            pos = positions[i]
+            req_idx = req_indices[i]
+ 
+            # 计算虚拟块索引
+            virtual_block_idx = pos // virtual_block_size
+            table_idx = req_idx * max_num_blocks_per_req + virtual_block_idx
+            block_number = block_table_flat[table_idx]
+            virtual_offset = pos % virtual_block_size
+ 
+            if (virtual_offset % dcp_world_size) == dcp_rank:
+                block_offset = virtual_offset // dcp_world_size
+                out_slot_mapping[i] = block_number * block_size + block_offset
+            else:
+                out_slot_mapping[i] = -1
+    else:
+        for i in range(num_tokens):
+            pos = positions[i]
+            req_idx = req_indices[i]
+ 
+            block_idx = pos // block_size
+            table_idx = req_idx * max_num_blocks_per_req + block_idx
+            block_number = block_table_flat[table_idx]
+            block_offset = pos % block_size
+            out_slot_mapping[i] = block_number * block_size + block_offset
+# =================================================
